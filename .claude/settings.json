{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go mod tidy:*)",
      "Bash(go mod download:*)",
      "Bash(go doc:*)",
      "Bash(gofmt:*)",
      "Bash(make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./data/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.db)",
      "Edit(./go.sum)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rmdir /s:*)",
      "Bash(del /s:*)",
      "Bash(Remove-Item:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "go run github.com/viniciusdev772/br_panel/tools/claudehook session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "go run github.com/viniciusdev772/br_panel/tools/claudehook guard",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "go run github.com/viniciusdev772/br_panel/tools/claudehook format",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "go run github.com/viniciusdev772/br_panel/tools/claudehook verify",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
