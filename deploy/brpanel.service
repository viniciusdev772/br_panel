[Unit]
Description=BR Panel
After=network.target

[Service]
ExecStart=/usr/local/bin/brpanel
EnvironmentFile=-/etc/brpanel.env
Restart=on-failure
# O painel precisa de root para gerenciar units systemd.
# Defina PANEL_APP_USER para que as aplicações rodem sem privilégios.

[Install]
WantedBy=multi-user.target
